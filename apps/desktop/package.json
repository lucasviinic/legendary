{
  "name": "desktop",
  "productName": "Legendary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vocabulário em inglês enquanto você assiste a séries e vídeos.",
  "author": "Lucas Vinicius",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest-electron.mjs run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:visual": "playwright test --config e2e/visual.config.ts",
    "design:capture": "node scripts/capture-design.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/deepseek": "3.0.80",
    "@ai-sdk/google": "4.0.112",
    "@legendary/contracts": "workspace:*",
    "@legendary/core": "workspace:*",
    "@legendary/db": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "ai": "7.0.163",
    "drizzle-orm": "0.45.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
